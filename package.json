{
  "name": "journal-style-options",
  "packageManager": "yarn@4.13.0",
  "version": "1.0.0",
  "description": "This module provides a set of options for customizing the appearance of journal entries in Foundry VTT, primarily based on existing APs",
  "license": "MIT",
  "scripts": {
    "build-all": "yarn build:css && yarn build",
    "build:css": "lessc src/styles/kingmaker/less/pf2e-km.less src/styles/kingmaker/pf2e-km.css",
    "build": "tsc && vite build"
  },
  "devDependencies": {
    "fvtt-types": "github:League-of-Foundry-Developers/foundry-vtt-types#main",
    "less": "^4.6.4",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-scss": "^4.0.1",
    "sass-embedded": "^1.99.0",
    "typescript": "^5.4.0",
    "vite": "^8.0.8"
  },
  "private":true
}
