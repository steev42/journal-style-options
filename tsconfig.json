{
 "compilerOptions": {
   "types": [
     "fvtt-types",
   ],
   "target": "ESNext",
   "useDefineForClassFields": true,
   "module": "node16",
   "lib": [
     "ESNext",
     "DOM"
   ],
   "moduleResolution": "node16",
   "strict": true,
   "sourceMap": true,
   "resolveJsonModule": true,
   "isolatedModules": false,
   "esModuleInterop": true,
   "noEmit": true,
   "noUnusedLocals": true,
   "noUnusedParameters": true,
   "noImplicitReturns": true,
   "noImplicitOverride": true,
   "noImplicitAny": true,
   "skipLibCheck": true
 },
 "include": [
   "src"
 ]
}